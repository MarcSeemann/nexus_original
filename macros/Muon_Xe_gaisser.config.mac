## Realistic atmospheric muon generator configuration with cos²θ distribution
## Generates muons on a plane above the detector with realistic angular distribution
## Tests the new Gaisser energy spectrum implementation

# Register the RealisticMuonGenerator
/nexus/RegisterGenerator RealisticMuonGenerator

# Realistic muon generator settings - Wider range for Gaisser spectrum
/Generator/RealisticMuon/min_energy 1 GeV
/Generator/RealisticMuon/max_energy 1000 GeV
/Generator/RealisticMuon/region MUON_PLANE

# Geometry configuration
/Geometry/Cigar/pressure 5.5 bar
/Geometry/Cigar/fiber_diameter 1 mm
/Geometry/Cigar/coating TPB
/Geometry/Cigar/fiber_type Y11
/Geometry/Cigar/gas Xe

# Verbosity settings
/run/verbose 1
/event/verbose 0
/tracking/verbose 0
/process/em/verbose 0

# Tracking configuration - FORCE ALL TRAJECTORIES TO BE STORED
/tracking/storeTrajectory 2

### JOB CONTROL
/nexus/random_seed            3
/nexus/persistency/start_id   0
/nexus/persistency/output_file Muon_Xe_gaisser_optical.next

### PERSISTENCY CONFIGURATION - Ensure all particles are saved
/nexus/persistency/save_particles true
